{
  "name": "feasibility",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "release": "npm test -- --watch=false && npm run package:release",
    "verify:release": "node scripts/verify-release.mjs",
    "check:production": "node scripts/check-production.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource/tajawal": "^5.3.0",
    "chart.js": "^4.5.1",
    "decimal.js": "^10.6.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.0",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
